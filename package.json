{
  "name": "battlefield",
  "version": "0.1.0",
  "description": "A fast abstract battle game for armies: sixty-one hexes, three actions, four wounds.",
  "type": "module",
  "license": "MIT",
  "author": "Mark Pearce",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.engine.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "import:troops": "node scripts/import-troops.mjs",
    "import:official": "node scripts/import-official.mjs",
    "import:engines": "node scripts/import-engines.mjs",
    "import:art": "node scripts/import-art.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/node": "^22.12.0",
    "svelte": "^5.46.4",
    "svelte-check": "^4.1.4",
    "typescript": "^5.9.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "pixi.js": "^7.4.3"
  }
}
